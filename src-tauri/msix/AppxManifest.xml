<?xml version="1.0" encoding="utf-8"?>
<!--
  MSIX manifest for the Microsoft Store build of the Cyber CTF launcher.
  Identity Name / Publisher MUST match Partner Center > Product Identity exactly,
  or the Store rejects the upload. __VERSION__ is substituted at build time
  (see .github/workflows/msix.yml); the fourth segment must stay .0 and the
  version must be higher than the currently published package.
-->
<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
  IgnorableNamespaces="uap rescap">

  <Identity
    Name="F4K.CyberCTF"
    Publisher="CN=EDDB085D-5E79-40C9-8A6B-3F5C06626CE3"
    Version="__VERSION__"
    ProcessorArchitecture="x64" />

  <Properties>
    <DisplayName>Cyber CTF</DisplayName>
    <PublisherDisplayName>F4K</PublisherDisplayName>
    <Logo>Assets\StoreLogo.png</Logo>
  </Properties>

  <Dependencies>
    <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.17763.0" MaxVersionTested="10.0.22621.0" />
  </Dependencies>

  <!-- The languages the app speaks; the Store lists them on the product page. Each has its strings
       in Strings/<lang>/Resources.resw (indexed into resources.pri at build time). -->
  <Resources>
    <Resource Language="en-us" />
    <Resource Language="fr-fr" />
    <Resource Language="es-es" />
    <Resource Language="de-de" />
    <Resource Language="pt-br" />
    <Resource Language="ja-jp" />
  </Resources>

  <Applications>
    <Application Id="CyberCTF" Executable="CyberCTF.exe" EntryPoint="Windows.FullTrustApplication">
      <uap:VisualElements
        DisplayName="Cyber CTF"
        Description="ms-resource:AppDescription"
        BackgroundColor="transparent"
        Square150x150Logo="Assets\Square150x150Logo.png"
        Square44x44Logo="Assets\Square44x44Logo.png">
        <uap:DefaultTile Square71x71Logo="Assets\Square71x71Logo.png" />
      </uap:VisualElements>
    </Application>
  </Applications>

  <Capabilities>
    <rescap:Capability Name="runFullTrust" />
  </Capabilities>
</Package>
